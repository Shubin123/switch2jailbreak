{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Test Result",
  "description": "Machine-readable output from a compatibility or isolation test run",
  "type": "object",
  "required": ["schema_version", "run_id", "timestamp", "target_id", "environment", "results"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this test run (ISO timestamp + random suffix)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "target_id": {
      "type": "string",
      "description": "References a target id from config/targets.json"
    },
    "environment": {
      "type": "object",
      "required": ["os", "node_version"],
      "properties": {
        "os": { "type": "string" },
        "os_version": { "type": "string" },
        "node_version": { "type": "string" },
        "browser_ua": {
          "type": "string",
          "description": "User-Agent string when testing browser-based routes"
        },
        "firmware_version": { "type": "string" },
        "network_config": { "type": "string" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id", "category", "name", "status"],
        "properties": {
          "test_id": {
            "type": "string",
            "description": "Unique test identifier, e.g. js-feat-001"
          },
          "category": {
            "type": "string",
            "enum": ["javascript-feature", "runtime-error", "isolation", "build", "network"]
          },
          "name": {
            "type": "string",
            "description": "Human-readable test name"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skip", "error"]
          },
          "expected": {
            "type": "string",
            "description": "What a passing result looks like"
          },
          "actual": {
            "type": "string",
            "description": "What actually happened"
          },
          "error_message": {
            "type": "string"
          },
          "duration_ms": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "errors": { "type": "integer" }
      }
    }
  }
}
